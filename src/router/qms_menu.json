      { "name": "LmeDetail", "path": "lme", "component": "@/application/lme-report/LmeReport.vue", "meta": { "title": "LME相关", "requiresAuth": true, "isKeepAlive": true, "isTabCloseAlive": false, "order": 2, "iconClass": "bi bi-clipboard-data", "elmenuitemgroup": "质量报告" } }
